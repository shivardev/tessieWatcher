# Copy to .env beside docker-compose.postgres.yml and replace both values.
TESLALOG_POSTGRES_PASSWORD=replace-with-a-long-random-password
TESLALOG_SERVER_TOKEN=replace-with-a-different-long-random-token
TESLALOG_AUTH_DISABLED=false
POSTGRES_BACKUP_RETENTION_DAYS=30

# Optional. Only required for: docker compose --profile public up -d
# Configure the tunnel's public hostname service as http://server:8085.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-cloudflare-tunnel-token
