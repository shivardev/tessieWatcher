            "uid": "${DS_SQLITE}"
          },
          "queryText": "SELECT timestamp AS time, outside_temp_c AS \"Outside\", inside_temp_c AS \"Inside\" FROM positions WHERE drive_id = $drive_id ORDER BY timestamp",
          "rawQueryText": "SELECT timestamp AS time, outside_temp_c AS \"Outside\", inside_temp_c AS \"Inside\" FROM positions WHERE drive_id = $drive_id ORDER BY timestamp",
          "queryType": "table",
          "timeColumns": [
