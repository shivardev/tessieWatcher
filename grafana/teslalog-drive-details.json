{
  "id": null,
  "uid": "teslalog-drive-details",
  "title": "teslalog: Drive Details",
  "description": "Per-drive drill-down (map, speed/power, elevation, temperatures, tire pressure) - reached by clicking a date in the Drives dashboard's table, matching TeslaMate's own drill-down.",
  "tags": [
    "teslalog"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "current": {
          "selected": false,
          "text": "SQLite",
          "value": "sqlite"
        },
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "DS_SQLITE",
        "options": [],
        "query": "frser-sqlite-datasource",
        "queryValue": "",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        },
        "hide": 2,
        "label": "drive_id",
        "name": "drive_id",
        "options": [],
        "query": "",
        "skipUrlSync": false,
        "type": "textbox"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Distance",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "${DS_SQLITE}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "${DS_SQLITE}"
          },
          "queryText": "SELECT ROUND(distance_km, 1) AS value FROM drives WHERE id = $drive_id",
          "rawQueryText": "SELECT ROUND(distance_km, 1) AS value FROM drives WHERE id = $drive_id",
          "queryType": "table",
          "timeColumns": [
            "time",
            "ts"
          ],
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "lengthkm",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Duration",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "${DS_SQLITE}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "${DS_SQLITE}"
          },
          "queryText": "SELECT ROUND(duration_min, 0) AS value FROM drives WHERE id = $drive_id",
          "rawQueryText": "SELECT ROUND(duration_min, 0) AS value FROM drives WHERE id = $drive_id",
          "queryType": "table",
          "timeColumns": [
            "time",
            "ts"
          ],
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Battery start → end",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "${DS_SQLITE}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "${DS_SQLITE}"
          },
          "queryText": "SELECT start_battery_level AS \"Start\", end_battery_level AS \"End\" FROM drives WHERE id = $drive_id",
          "rawQueryText": "SELECT start_battery_level AS \"Start\", end_battery_level AS \"End\" FROM drives WHERE id = $drive_id",
          "queryType": "table",
          "timeColumns": [
            "time",
            "ts"
          ],
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "orientation": "horizontal"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Max speed",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "${DS_SQLITE}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "${DS_SQLITE}"
          },
          "queryText": "SELECT ROUND(max_speed_kmh, 0) AS value FROM drives WHERE id = $drive_id",
          "rawQueryText": "SELECT ROUND(max_speed_kmh, 0) AS value FROM drives WHERE id = $drive_id",
          "queryType": "table",
          "timeColumns": [
            "time",
            "ts"
          ],
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "velocitykmh",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "geomap",
      "title": "Route",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "${DS_SQLITE}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "${DS_SQLITE}"
          },
          "queryText": "SELECT latitude, longitude, speed_kmh, timestamp AS time FROM positions WHERE drive_id = $drive_id AND latitude IS NOT NULL ORDER BY timestamp",
          "rawQueryText": "SELECT latitude, longitude, speed_kmh, timestamp AS time FROM positions WHERE drive_id = $drive_id AND latitude IS NOT NULL ORDER BY timestamp",
          "queryType": "table",
          "timeColumns": [
            "time",
            "ts"
          ],
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "view": {
          "id": "fit",
          "lat": 0,
          "lon": 0,
          "zoom": 12,
          "padding": 32
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true,
          "showAttribution": true,
          "showScale": false,
          "showMeasure": false,
          "showDebug": false
        },
        "basemap": {
          "type": "default",
          "name": "Basemap",
          "config": {}
        },
        "layers": [
          {
            "type": "route",
            "name": "Route",
            "config": {
              "style": {
                "color": {
                  "fixed": "#3ea6ff"
                },
                "size": {
                  "fixed": 3
                }
              }
            },
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            }
          },
          {
            "type": "markers",
            "name": "Points",
            "config": {
              "style": {
                "size": {
                  "fixed": 4
                },
                "color": {
                  "field": "speed_kmh",
                  "fixed": "#3ea6ff"
                },
                "symbol": {
                  "fixed": "img/icons/marker/circle.svg"
                }
              }
            },
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            }
          }
        ]
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Speed & power",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "${DS_SQLITE}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "${DS_SQLITE}"
          },
          "queryText": "SELECT timestamp AS time, speed_kmh AS \"Speed (km/h)\", power_kw AS \"Power (kW)\" FROM positions WHERE drive_id = $drive_id ORDER BY timestamp",
          "rawQueryText": "SELECT timestamp AS time, speed_kmh AS \"Speed (km/h)\", power_kw AS \"Power (kW)\" FROM positions WHERE drive_id = $drive_id ORDER BY timestamp",
          "queryType": "table",
          "timeColumns": [
            "time",
            "ts"
          ],
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 3
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Elevation",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "${DS_SQLITE}"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "${DS_SQLITE}"
          },
          "queryText": "SELECT timestamp AS time, elevation_m AS \"Elevation (m)\" FROM positions WHERE drive_id = $drive_id AND elevation_m IS NOT NULL ORDER BY timestamp",
          "rawQueryText": "SELECT timestamp AS time, elevation_m AS \"Elevation (m)\" FROM positions WHERE drive_id = $drive_id AND elevation_m IS NOT NULL ORDER BY timestamp",
          "queryType": "table",
          "timeColumns": [
            "time",
            "ts"
          ],
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "lengthm",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "pointSize": 3
